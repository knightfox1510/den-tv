<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only den-tv app that goes online: TheSportsDB for matches, AniList for episodes, and the phone
         settings page on the home Wi-Fi while the Fan Hub screen is open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To show the TV's address on the home network for the phone page. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The phone page changes the look through the launcher, which allows only den-tv's own apps. -->
    <uses-permission android:name="tv.den.permission.LOOKS" />
    <!-- The phone app keeps running while the TV is on (PhoneService), and comes back after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Close background apps" and the Wi-Fi strength on the phone's TV page. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Updates: den-tv and the Fan Hub from the repo's releases (Updater); on Android 12 and later without asking
         each time, as their installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Only granted over USB debugging (HomeSetup, the installers): puts the helper back on after an update. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Speed up (Speedup): which of a tested list's apps are on this TV, and which drive its inputs, Settings or keyboard. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <provider android:authorities="tv.den.launcher.looks" />
        <!-- den-tv itself: its version, for updates, and whether it is the home screen. -->
        <package android:name="tv.den.launcher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The TV's apps, for the remote's app list and watch now. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Fan Hub"
        android:icon="@drawable/fanhub_banner"
        android:banner="@drawable/fanhub_banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The launcher's game_day contract: Home reads this provider's turns (GameDay.META). -->
        <meta-data android:name="com.gathin.tvhome.games" android:value="tv.den.fanhub.games" />

        <provider
            android:name=".TurnsProvider"
            android:authorities="tv.den.fanhub.games"
            android:exported="true" />

        <!-- Screen time per app for the den-tv launcher's tile badges; only an app with den-tv's key may read it. -->
        <provider
            android:name=".StatsProvider"
            android:authorities="tv.den.fanhub.stats"
            android:exported="true" />

        <service
            android:name=".PhoneService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the den-tv phone remote on the home network while the TV is on" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The den-tv helper (Settings, Accessibility): Back, Home, sleep, typing and opening apps from the phone. -->
        <service
            android:name=".Helper"
            android:exported="true"
            android:label="den-tv helper"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/helper" />
        </service>

        <!-- How an update install went (Updater). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Makes den-tv the home screen from the TV itself (HomeSetup over Adb). Exported so the TV's shell can
             bring it back to the front once den-tv has started; it only acts on buttons pressed on screen. -->
        <activity
            android:name=".HomeSetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="tv.den.fanhub.home"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- den-tv's first-time setup; the launcher opens it after install and from its Looks screen. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true" />

        <activity
            android:name=".FanHubActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only den-tv app that goes online: TheSportsDB for matches, AniList for episodes, and the phone
         settings page on the home Wi-Fi while the Fan Hub screen is open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To show the TV's address on the home network for the phone page. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The phone page changes the look through the launcher, which allows only den-tv's own apps. -->
    <uses-permission android:name="tv.den.permission.LOOKS" />
    <!-- The phone app keeps running while the TV is on (PhoneService), and comes back after a restart. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Close background apps" and the Wi-Fi strength on the phone's TV page. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <queries>
        <provider android:authorities="tv.den.launcher.looks" />
        <!-- The TV's apps, for the remote's app list and watch now. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Fan Hub"
        android:icon="@drawable/fanhub_banner"
        android:banner="@drawable/fanhub_banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The launcher's game_day contract: Home reads this provider's turns (GameDay.META). -->
        <meta-data android:name="com.gathin.tvhome.games" android:value="tv.den.fanhub.games" />

        <provider
            android:name=".TurnsProvider"
            android:authorities="tv.den.fanhub.games"
            android:exported="true" />

        <service
            android:name=".PhoneService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the den-tv phone remote on the home network while the TV is on" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The den-tv helper (Settings, Accessibility): Back, Home, sleep, typing and opening apps from the phone. -->
        <service
            android:name=".Helper"
            android:exported="true"
            android:label="den-tv helper"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/helper" />
        </service>

        <!-- den-tv's first-time setup; the launcher opens it after install and from its Looks screen. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true" />

        <activity
            android:name=".FanHubActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
